        {
          "id": "webhook-echo-status",
          "kind": "status",
          "expected": "2xx"
        },
        {
          "id": "webhook-echo-version-existe",
          "kind": "jsonpath",
          "path": "$.args.version",
          "op": "exists"
        },
        {
          "id": "webhook-echo-tiempo",
          "kind": "time",
          "maxMs": 8000
        }
      ]
    },
    {
      "id": "webhook-divisas-latest",
