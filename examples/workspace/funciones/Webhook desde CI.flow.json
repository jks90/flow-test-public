      "id": "webhook-echo-version",
      "name": "1 · Echo — GET httpbingo con version",
      "curl": "curl \"https://httpbingo.org/get?version={{version}}\" \\\n\n-H \"User-Agent: flow-test\"",
      "position": {
        "x": 80,
        "y": 855
      },
      "status": "idle",
      "collapsed": false,
      "extractions": [],
