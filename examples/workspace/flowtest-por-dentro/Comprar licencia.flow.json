      "opacity": 1, "sketchy": true, "seed": 4214
    },
    {
      "id": "wb-pie-marco",
      "type": "text",
      "x": 40, "y": 1210, "w": 560, "h": 28,
      "stroke": "#f59e0b", "strokeWidth": 2, "strokeStyle": "solid",
      "opacity": 0.9, "sketchy": true, "seed": 4215,
      "text": "3 pasos reales contra app.flowtest.es — sin datos de pago",
      "font": "hand", "fontSize": 16
    }
  ]
}
