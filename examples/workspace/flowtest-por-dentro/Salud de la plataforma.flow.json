      "stroke": "#f59e0b", "strokeWidth": 2, "strokeStyle": "dashed",
      "fill": "transparent", "opacity": 0.85, "sketchy": true, "seed": 7302
    },
    {
      "id": "wb-etiqueta-monitor",
      "type": "text",
      "x": 50, "y": 576, "w": 340, "h": 24,
      "text": "monitor 24x7 · settings.monitor",
