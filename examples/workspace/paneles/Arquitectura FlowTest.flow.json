  "name": "Arquitectura FlowTest",
  "nodes": [
    {
      "id": "req-salud-cloud",
      "name": "Salud cloud",
      "curl": "curl \"{{cloudBase}}/health\"",
      "position": {
        "x": 80,
        "y": 860
      },
      "status": "idle",
      "extractions": [
        {
          "id": "x-servicio-cloud",
          "varName": "servicioCloud",
          "jsonPath": "$.service"
        },
        {
          "id": "x-orgs-activas",
          "varName": "orgsActivas",
          "jsonPath": "$.orgs"
        }
      ],
      "asserts": [
        {
          "id": "a-salud-status",
          "kind": "status",
          "expected": "2xx"
        },
        {
          "id": "a-salud-ok",
          "kind": "jsonpath",
          "path": "$.ok",
          "op": "equals",
          "value": "true"
        },
        {
          "id": "a-salud-time",
          "kind": "time",
          "maxMs": 8000
        }
      ],
      "collapsed": true,
      "cell": {
        "col": 1,
        "row": 2
      }
    },
    {
      "id": "req-validar-licencia",
      "name": "Validación de licencias",
      "curl": "curl -X POST \"{{cloudBase}}/api/license/validate\" \\\n\n-H \"Content-Type: application/json\" \\\n\n-d '{\"token\":\"{{tokenLicencia}}\"}'",
      "position": {
        "x": 500,
        "y": 860
      },
      "status": "idle",
      "extractions": [
        {
          "id": "x-motivo-licencia",
          "varName": "motivoLicencia",
          "jsonPath": "$.reason"
        }
      ],
      "asserts": [
        {
          "id": "a-lic-status",
          "kind": "status",
          "expected": "2xx"
        },
        {
          "id": "a-lic-valid-false",
          "kind": "jsonpath",
          "path": "$.valid",
          "op": "equals",
          "value": "false"
        }
      ],
      "collapsed": true,
      "cell": {
        "col": 2,
        "row": 2
      }
    },
    {
      "id": "req-plan-org",
      "name": "Plan de una org",
      "curl": "curl \"{{cloudBase}}/api/org-plan/{{orgSlug}}\"",
      "position": {
        "x": 920,
        "y": 860
      },
      "status": "idle",
      "extractions": [],
      "asserts": [
        {
          "id": "as-orgplan-status",
          "kind": "status",
          "expected": "2xx"
        },
        {
          "id": "as-orgplan-plan",
          "kind": "jsonpath",
          "path": "$.plan",
          "op": "exists"
        }
      ],
      "collapsed": true,
      "cell": {
        "col": 3,
        "row": 2
      }
    },
    {
      "id": "req-web-publica",
      "name": "Web pública",
