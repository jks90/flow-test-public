{
  "version": "1.0",
  "name": "Mapa mundial",
  "nodes": [
    {
      "id": "n1-nueva-york-clima",
      "name": "1 · 🇺🇸 Nueva York — clima",
      "curl": "curl '{{meteoBase}}/v1/forecast?latitude=40.71&longitude=-74.01&current=temperature_2m,wind_speed_10m'",
      "position": { "x": 560, "y": 850 },
      "status": "idle",
      "extractions": [
        { "id": "x-temp-nueva-york", "varName": "tempNuevaYork", "jsonPath": "$.current.temperature_2m" }
      ],
      "asserts": [
        { "id": "a-n1-status", "kind": "status", "expected": "2xx" },
        { "id": "a-n1-temp", "kind": "jsonpath", "path": "$.current.temperature_2m", "op": "exists" },
        { "id": "a-n1-time", "kind": "time", "maxMs": 8000 }
      ],
      "collapsed": true
    },
    {
