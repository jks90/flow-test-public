{
  "version": "1.0",
  "name": "Login anotado en la pizarra",
  "nodes": [
    {
      "id": "login",
      "name": "Login",
      "curl": "curl -X POST \"{{apiBase}}/auth/login\" -H \"Content-Type: application/json\" -d '{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}'",
      "position": { "x": 100, "y": 160 },
      "status": "idle",
      "collapsed": false,
      "order": 1,
      "extractions": [
        { "id": "e1", "varName": "token", "jsonPath": "$.accessToken" }
      ]
    },
    {
      "id": "listar",
      "name": "Listar usuarios",
      "curl": "curl \"{{apiBase}}/users\" -H \"Authorization: Bearer {{token}}\"",
      "position": { "x": 620, "y": 160 },
      "status": "idle",
      "collapsed": false,
      "order": 2,
      "extractions": [
        { "id": "e2", "varName": "primerUsuario", "jsonPath": "$[0].id" }
      ]
    },
    {
      "id": "detalle",
      "name": "Detalle del primer usuario",
      "curl": "curl \"{{apiBase}}/users/{{primerUsuario}}\" -H \"Authorization: Bearer {{token}}\"",
      "position": { "x": 1140, "y": 160 },
      "status": "idle",
      "collapsed": false,
      "order": 3,
      "pinned": true,
      "extractions": []
    }
  ],
  "infoNodes": [
    {
      "id": "nota-email",
      "name": "Email único por ejecución",
      "content": "El script de abajo genera un email distinto en cada Run Flow y lo deja en {{emailUnico}} antes de la primera petición (desde la 4.23.0 los scripts de las notas se ejecutan solos al pulsar Run Flow y en el CLI).",
      "position": { "x": 100, "y": 560 },
      "collapsed": false,
      "scripts": [
        { "id": "s1", "varName": "emailUnico", "code": "return 'qa+' + Date.now() + '@example.com';" }
      ]
    }
  ],
  "sqlNodes": [],
  "webNodes": [],
  "connections": [
    { "id": "c1", "sourceId": "login", "targetId": "listar", "behavior": "next" },
